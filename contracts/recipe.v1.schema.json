{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generaterecipe_backend/schemas/recipe.v1.schema.json",
  "title": "GenerateRecipe v1 recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "description",
    "source",
    "servings",
    "prep_time",
    "cook_time",
    "total_time",
    "equipment",
    "ingredients",
    "instructions",
    "warnings",
    "missing_information"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "$ref": "#/$defs/textField"
    },
    "description": {
      "$ref": "#/$defs/textField"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "original_url",
        "video_id",
        "video_title",
        "creator"
      ],
      "properties": {
        "platform": {
          "const": "youtube"
        },
        "original_url": {
          "type": "string",
          "format": "uri"
        },
        "video_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{11}$"
        },
        "video_title": {
          "$ref": "#/$defs/textField"
        },
        "creator": {
          "$ref": "#/$defs/textField"
        }
      }
    },
    "servings": {
      "$ref": "#/$defs/numberField"
    },
    "prep_time": {
      "$ref": "#/$defs/duration"
    },
    "cook_time": {
      "$ref": "#/$defs/duration"
    },
    "total_time": {
      "$ref": "#/$defs/duration"
    },
    "equipment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/textField"
      }
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ingredient"
      }
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/instruction"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "explicit",
            "observed",
            "estimated",
            "not_specified"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "description",
                  "transcript",
                  "caption",
                  "metadata",
                  "visual"
                ]
              },
              "excerpt": {
                "type": "string",
                "maxLength": 500
              },
              "start_seconds": {
                "type": "number",
                "minimum": 0
              },
              "end_seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "textField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "provenance"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "properties": {
              "provenance": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "not_specified"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "provenance": {
                "type": "object",
                "properties": {
                  "kind": {
                    "not": {
                      "const": "not_specified"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "numberField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "provenance"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "properties": {
              "provenance": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "not_specified"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "provenance": {
                "type": "object",
                "properties": {
                  "kind": {
                    "not": {
                      "const": "not_specified"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seconds",
        "text",
        "provenance"
      ],
      "properties": {
        "seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "seconds": {
                "type": "null"
              },
              "text": {
                "type": "null"
              }
            },
            "required": [
              "seconds",
              "text"
            ]
          },
          "then": {
            "properties": {
              "provenance": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "not_specified"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "provenance": {
                "type": "object",
                "properties": {
                  "kind": {
                    "not": {
                      "const": "not_specified"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "amount_text",
        "unit",
        "provenance"
      ],
      "properties": {
        "amount": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "amount_text": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "amount": {
                "type": "null"
              },
              "amount_text": {
                "type": "null"
              },
              "unit": {
                "type": "null"
              }
            },
            "required": [
              "amount",
              "amount_text",
              "unit"
            ]
          },
          "then": {
            "properties": {
              "provenance": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "not_specified"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "provenance": {
                "type": "object",
                "properties": {
                  "kind": {
                    "not": {
                      "const": "not_specified"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "quantity",
        "preparation_notes",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "$ref": "#/$defs/quantity"
        },
        "preparation_notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textField"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "phase",
        "text",
        "duration",
        "ingredient_ids",
        "provenance"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "enum": [
            "preparation",
            "cooking"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "duration": {
          "$ref": "#/$defs/duration"
        },
        "ingredient_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    }
  }
}
